    {
      "severity": "BUG",
      "vulnSlug": "other-resource-leak",
      "title": "Async subscription setup can leak after component unmount",
      "description": "The effect assigns the unsubscribe function only after subscribe() resolves. If the component unmounts first, cleanup sees stop as undefined and does nothing; the later resolution installs a live subscription that can no longer be reached or stopped. Repeated fast mount/unmount cycles can accumulate listeners and trigger state updates on unmounted components. A rejection of the initial subscribe promise is also not handled by the shown code.",
      "lineNumbers": [
        151,
        159
      ],
      "recommendation": "Track a cancelled flag. When subscribe resolves, immediately invoke the returned unsubscribe function if cleanup already ran; otherwise save it. Also attach a catch handler for setup failures.",
      "confidence": "high",
      "producedByRunId": "20260820082023-71b34e159c890b44",
      "findingId": "finding_4090a5506b6e219e"
    }
