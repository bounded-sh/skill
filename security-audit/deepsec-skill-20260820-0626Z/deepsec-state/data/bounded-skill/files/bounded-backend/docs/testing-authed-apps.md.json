    {
      "severity": "BUG",
      "vulnSlug": "other-cli-contract-mismatch",
      "title": "Authenticated test helper reads an address field that bounded account does not return",
      "description": "The helper invokes `bounded account --json` and reads acct.address to construct the session-cache key. The current CLI account command reports project and account configuration metadata but does not include an address field. Consequently acct.address is undefined, the helper searches for `<appId>:undefined`, and it throws even when a valid wallet session exists. This breaks the documented authenticated E2E setup before any test request is made.",
      "lineNumbers": [
        71,
        76,
        78,
        79,
        80
      ],
      "recommendation": "Use `bounded whoami --json`, which returns the resolved wallet address, or derive the public address from the supplied private key. Validate that the address is a non-empty wallet identity before using it to select the exact app-and-wallet session entry.",
      "confidence": "high",
      "producedByRunId": "20260820080435-39421ba804cea7fa",
      "findingId": "finding_5b74083a75f46789"
    }
