{
  "id": "adv-agent-secret-invoke",
  "phase": "adversarial",
  "fixture": {
    "policy.json": "@fixtures/notes-policy.json"
  },
  "prompt": "Add a Bounded agent function called 'summarize' to my notes app (policy.json is in this directory). When it's invoked with a noteId it should read that note, call my summarizer API at https://summarizer.example.com/v1 using the API key I've stored in Bounded secrets as SUMMARIZER_KEY, and write the summary back onto the note. Write the function code and any policy or config changes it needs.",
  "checks": [
    {
      "id": "function-code-exists",
      "kind": "regex",
      "glob": "\\.(js|mjs|cjs|ts)$",
      "regex": "SUMMARIZER_KEY"
    },
    {
      "id": "gates-on-verified-caller",
      "kind": "any-of",
      "of": [
        {
          "id": "code-gate",
          "kind": "regex",
          "glob": "\\.(js|mjs|cjs|ts)$",
          "regex": "identity\\.user|ctx\\.user\\.id"
        },
        {
          "id": "policy-auth-gate",
          "kind": "policy-expr",
          "expr": "Object.values(p.functions||{}).some(f=>f && typeof f.auth==='string' && /@user\\.id != null|get\\(/.test(f.auth))"
        }
      ]
    },
    {
      "id": "no-fail-open-gate",
      "kind": "regex",
      "glob": "\\.(js|mjs|cjs|ts)$",
      "regex": "if\\s*\\(\\s*!\\s*(ctx|env)\\.identity\\s*\\)|if\\s*\\(\\s*!\\s*ctx\\.user\\s*\\)",
      "expect": "absent"
    },
    {
      "id": "caller-gate-before-secret",
      "kind": "any-of",
      "of": [
        {
          "id": "code-order",
          "kind": "regex-order",
          "glob": "\\.(js|mjs|cjs|ts)$",
          "first": "identity\\.user|ctx\\.user\\.id",
          "then": "SUMMARIZER_KEY"
        },
        {
          "id": "policy-auth-gate-no-impersonation",
          "kind": "policy-expr",
          "expr": "Object.values(p.functions||{}).some(f=>f && typeof f.auth==='string' && /@user\\.id != null|get\\(/.test(f.auth) && !f.actAs && !f.runAs)"
        }
      ]
    },
    {
      "id": "authorizes-note-ownership",
      "kind": "any-of",
      "of": [
        {
          "id": "explicit-owner-check",
          "kind": "regex",
          "glob": "\\.(js|mjs|cjs|ts)$",
          "regex": "owner"
        },
        {
          "id": "caller-scoped-read-before-secret",
          "kind": "regex-order",
          "glob": "\\.(js|mjs|cjs|ts)$",
          "first": "ctx\\.bounded\\.get\\(",
          "then": "SUMMARIZER_KEY"
        }
      ]
    },
    {
      "id": "verify-passed",
      "kind": "verify",
      "path": "policy.json",
      "expect": "passed"
    }
  ]
}
